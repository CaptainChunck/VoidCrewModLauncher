<UserControl x:Class="VoidCrewModLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:VoidCrewModLauncher.Infrastructure"
             xmlns:c="clr-namespace:VoidCrewModLauncher.Controls">
    <UserControl.Resources>
        <!-- A package icon with the first letter behind it while it loads (or when it has none). -->
        <DataTemplate x:Key="IconTemplate">
            <Grid>
                <c:ShapeBorder Shape="ChamferTile" Cut="8" Background="#30BDE7FB" BorderBrush="#60BDE7FB" BorderThickness="1" />
                <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource LightBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <Style x:Key="InstalledItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlainRowItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- INSTALLED / BROWSE -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource SubTab}" GroupName="ModsTab" IsChecked="{Binding ShowBrowse, Converter={StaticResource Not}}">
                <TextBlock>
                    <Run Text="{i:T INSTALLED}" /> <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource SubTab}" GroupName="ModsTab" Content="{i:T MODS}" IsChecked="{Binding ShowBrowse}" />
        </StackPanel>

        <Grid>
            <!-- ======================================================== INSTALLED -->
            <DockPanel Visibility="{Binding ShowBrowse, Converter={StaticResource Hide}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                    <TextBox DockPanel.Dock="Left" Width="300" Text="{Binding InstalledSearch, UpdateSourceTrigger=PropertyChanged}" Tag="{i:T Search your mods}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding UpdateAllText}" Command="{Binding UpdateAllCommand}" Margin="8,0,0,0"
                            Visibility="{Binding UpdateCount, Converter={StaticResource Show}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource HexButton}" Content="{i:T IMPORT FROM BEPINEX}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource HexButton}" Content="{i:T ADD MOD FILE}" Command="{Binding AddLocalCommand}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8">
                    <Run>
                        <Run.Text>
                            <MultiBinding StringFormat="{i:T '\{0\} of \{1\} on'}" Mode="OneWay">
                                <Binding Path="EnabledCount" />
                                <Binding Path="InstalledCount" />
                            </MultiBinding>
                        </Run.Text>
                    </Run> <Run Text=" ·" />
                    <Run Text="{Binding BepInExText, Mode=OneWay}" />
                </TextBlock>

                <Grid>
                    <ListBox ItemsSource="{Binding InstalledView}" ItemContainerStyle="{StaticResource InstalledItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Width="44" Height="44" Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" VerticalAlignment="Center" Focusable="False" />
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Text="{Binding Version}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource LightBlue}" Margin="10,0,0,0" Visibility="{Binding IsLocal, Converter={StaticResource Show}}">
                                                <TextBlock Text="{i:T LOCAL}" Style="{StaticResource BadgeText}" Foreground="{StaticResource LightBlue}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource LightBlue}" Margin="10,0,0,0" Visibility="{Binding FromGitHub, Converter={StaticResource Show}}">
                                                <TextBlock Text="GITHUB" Style="{StaticResource BadgeText}" Foreground="{StaticResource LightBlue}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource LightGrey}" Margin="10,0,0,0" Visibility="{Binding IsDependency, Converter={StaticResource Show}}">
                                                <TextBlock Text="{i:T DEPENDENCY}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                        <TextBlock Text="{Binding JoinText}" FontSize="11.5" Foreground="{StaticResource LightBlue}" Opacity="0.8" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SmallPrimaryButton}" Content="{Binding UpdateText}" Margin="0,0,14,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource Show}}" />
                                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource LinkButton}" Content="&#x2022;&#x2022;&#x2022;" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Click="MoreButton_Click" ToolTip="{i:T More}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{i:T When joining other lobbies}">
                                                    <MenuItem Header="{i:T Decide for me (keep client-side mods)}" IsCheckable="False" IsChecked="{Binding JoinAuto, Mode=OneWay}"
                                                              Command="{Binding PlacementTarget.Tag.SetJoinBehaviourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource Pack}">
                                                                <Binding />
                                                                <Binding Source="Auto" />
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                    </MenuItem>
                                                    <MenuItem Header="{i:T Always keep it on}" IsChecked="{Binding JoinKeep, Mode=OneWay}"
                                                              Command="{Binding PlacementTarget.Tag.SetJoinBehaviourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource Pack}">
                                                                <Binding />
                                                                <Binding Source="Keep" />
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                    </MenuItem>
                                                    <MenuItem Header="{i:T Only when the lobby runs it}" IsChecked="{Binding JoinOnlyIfLobby, Mode=OneWay}"
                                                              Command="{Binding PlacementTarget.Tag.SetJoinBehaviourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource Pack}">
                                                                <Binding />
                                                                <Binding Source="OnlyIfLobbyHasIt" />
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                    </MenuItem>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{i:T Open its folder}" Command="{Binding PlacementTarget.Tag.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{i:T View on Thunderstore}" Command="{Binding PlacementTarget.Tag.OpenModPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{i:T Remove}" Command="{Binding PlacementTarget.Tag.UninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:ShapeBorder Style="{StaticResource PopupPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                                   Visibility="{Binding InstalledCount, Converter={StaticResource Hide}}">
                        <StackPanel>
                            <TextBlock Text="{i:T NO MODS YET}" Style="{StaticResource H1}" FontSize="22" HorizontalAlignment="Center" />
                            <Grid Style="{StaticResource PanelRule}">
                                <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Center" Opacity="0.7" />
                                <Border Width="44" Height="3" Background="{StaticResource Orange}" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Text="{i:T Get mods from the MODS tab.}" />
                        </StackPanel>
                    </c:ShapeBorder>
                </Grid>
            </DockPanel>

            <!-- ======================================================== BROWSE -->
            <Grid Visibility="{Binding ShowBrowse, Converter={StaticResource Show}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="260" Text="{Binding OnlineSearch, UpdateSourceTrigger=PropertyChanged}" Tag="{i:T Search Thunderstore}" Margin="0,0,10,6" />
                        <ComboBox Width="190" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,6" />
                        <ComboBox Width="170" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Margin="0,0,10,6" />
                        <ToggleButton Style="{StaticResource Chip}" Content="{i:T DEPRECATED}" IsChecked="{Binding ShowDeprecated}" Margin="0,0,10,6" />
                        <Button Style="{StaticResource SmallButton}" Content="{i:T REFRESH}" Command="{Binding RefreshOnlineListCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding OnlineView}" SelectedItem="{Binding SelectedPackage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Loaded="PackageRow_Loaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Width="52" Height="52" Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" VerticalAlignment="Top" Focusable="False" />
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" Background="#E6101420" BorderBrush="{StaticResource Red}" Margin="8,0,0,0" Visibility="{Binding IsDeprecated, Converter={StaticResource Show}}">
                                                <TextBlock Text="{i:T DEPRECATED}" Style="{StaticResource BadgeText}" Foreground="{StaticResource Red}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#E6101420" BorderBrush="{StaticResource LightBlue}" Margin="8,0,0,0" Visibility="{Binding LatestFromGitHub, Converter={StaticResource Show}}">
                                                <TextBlock Text="GITHUB" Style="{StaticResource BadgeText}" Foreground="{StaticResource LightBlue}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#E6101420" BorderBrush="{StaticResource Orange}" Margin="8,0,0,0" Visibility="{Binding LatestFromWebsite, Converter={StaticResource Show}}">
                                                <TextBlock Text="{i:T WEBSITE}" Style="{StaticResource BadgeText}" Foreground="{StaticResource Orange}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.85" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Badge}" Background="#E6101420" BorderBrush="#7FBDE7FB" Margin="0,0,5,2">
                                                        <TextBlock Text="{Binding Converter={StaticResource Upper}}" Style="{StaticResource BadgeText}" FontSize="10" Foreground="{StaticResource LightBlue}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.8">
                                            <Run Text="&#x2193;" /> <Run Text="{Binding Downloads, Mode=OneWay}" /> <Run Text="  &#x2605;" /> <Run Text="{Binding Rating, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <Button Content="{Binding ActionText}" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallPrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Details -->
                <c:ShapeBorder Grid.Column="2" Style="{StaticResource DarkPanel}">
                    <Grid>
                        <TextBlock Text="{i:T Pick a mod to read about it.}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedPackage, Converter={StaticResource Hide}}" />
                        <DockPanel Visibility="{Binding SelectedPackage, Converter={StaticResource Show}}">
                            <Grid DockPanel.Dock="Top" DataContext="{Binding SelectedPackage}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Width="76" Height="76" Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}" VerticalAlignment="Top" Focusable="False" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding LatestVersion, Mode=OneWay, StringFormat=v{0}}" /> <Run Text="·" /> <Run Text="{Binding FileSize, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,6">
                                <Button Content="{Binding SelectedPackage.ActionText}" Command="{Binding InstallCommand}" CommandParameter="{Binding SelectedPackage}" Margin="0,0,8,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPackage.IsUpToDate}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource HexButton}" Content="THUNDERSTORE" Command="{Binding OpenPackagePageCommand}" CommandParameter="{Binding SelectedPackage}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource HexButton}" Content="{i:T WEBSITE}" Command="{Binding OpenPackageWebsiteCommand}" CommandParameter="{Binding SelectedPackage}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap">
                                <Run Text="{i:T NEEDS:}" Foreground="{StaticResource LightBlue}" FontWeight="SemiBold" /> <Run Text="{Binding SelectedPackage.Dependencies, Mode=OneWay}" />
                            </TextBlock>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LightGrey}" Margin="0,0,0,10" />
                            <FlowDocumentScrollViewer Document="{Binding Readme}" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Focusable="False" />
                        </DockPanel>
                    </Grid>
                </c:ShapeBorder>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
