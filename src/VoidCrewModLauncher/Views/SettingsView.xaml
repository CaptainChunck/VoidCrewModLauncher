<UserControl x:Class="VoidCrewModLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VoidCrewModLauncher.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <HeaderedContentControl Style="{StaticResource Section}" Header="GAME">
                    <StackPanel>
                        <TextBlock Text="VOID CREW FOLDER" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding GameDirectory, Mode=OneWay}" IsReadOnly="True" Tag="Not found" />
                        <TextBlock Text="{Binding GameText}" Style="{StaticResource Muted}" Margin="0,4,0,8" />
                        <WrapPanel>
                            <Button Style="{StaticResource SmallButton}" Content="CHOOSE FOLDER" Command="{Binding BrowseGameCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="FIND THROUGH STEAM" Command="{Binding FindGameCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="OPEN" Command="{Binding OpenGameFolderCommand}" Margin="0,0,8,6" />
                        </WrapPanel>

                        <DockPanel Margin="0,16,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LaunchThroughSteam}" VerticalAlignment="Center" />
                            <TextBlock Text="START THROUGH STEAM" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>

                        <DockPanel Margin="0,16,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowBepInExConsole}" VerticalAlignment="Center" />
                            <TextBlock Text="SHOW BEPINEX CONSOLE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>

                        <TextBlock Text="BEPINEX LOADER IN THE GAME FOLDER" Style="{StaticResource Label}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding LoaderText}" Style="{StaticResource Body}" FontSize="13" />
                        <Button Style="{StaticResource SmallButton}" Content="REMOVE THE LAUNCHER'S LOADER" Command="{Binding RemoveLoaderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding CanRemoveLoader, Converter={StaticResource Show}}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Section}" Header="SERVER BROWSER" Margin="0,24,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeWhenBrowsing}" VerticalAlignment="Center" />
                        <TextBlock Text="KEEP THE LAUNCHER IN FRONT WHILE BROWSING" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Section}" Header="UPDATES" Margin="0,24,0,0">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdateLauncher}" VerticalAlignment="Center" />
                            <TextBlock Text="UPDATE THE LAUNCHER AUTOMATICALLY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <DockPanel Margin="0,16,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdateMods}" VerticalAlignment="Center" />
                            <TextBlock Text="UPDATE MODS AUTOMATICALLY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <DockPanel Margin="0,16,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GitHubUpdates}" VerticalAlignment="Center" />
                            <TextBlock Text="NEWER MOD VERSIONS FROM GITHUB" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <Button Style="{StaticResource SmallButton}" Content="CHECK FOR UPDATES" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <HeaderedContentControl Style="{StaticResource Section}" Header="FILES">
                    <StackPanel>
                        <TextBlock Text="LAUNCHER FOLDER" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Text="{Binding StoreText}" Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Style="{StaticResource SmallButton}" Content="OPEN FOLDER" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="MOD SETTINGS (CONFIG)" Command="{Binding OpenConfigFolderCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="LAUNCHER LOG" Command="{Binding OpenLauncherLogCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="GAME LOG" Command="{Binding OpenGameLogCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource SmallButton}" Content="FREE UP SPACE" Command="{Binding FreeSpaceCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Section}" Header="ABOUT" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding VersionText}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,0" Text="Mods from Thunderstore. Not made or supported by Hutlihut Games." />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding RepositoryUrl}" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Left" Margin="-4,8,0,0" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
