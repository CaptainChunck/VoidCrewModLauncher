<UserControl x:Class="VoidCrewModLauncher.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:VoidCrewModLauncher.Infrastructure"
             xmlns:c="clr-namespace:VoidCrewModLauncher.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ settings, in the main menu's panel -->
        <c:ShapeBorder Style="{StaticResource PopupPanel}" VerticalAlignment="Top" Padding="26,22,26,18">
            <StackPanel>
                <c:SpacedText Value="{i:T HOST LOBBY}" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                <Grid Style="{StaticResource PanelRule}">
                    <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Center" Opacity="0.7" />
                    <Border Width="44" Height="3" Background="{StaticResource Orange}" HorizontalAlignment="Center" />
                </Grid>

                <TextBlock Text="{i:T LOBBY NAME}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding LobbyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Tag="{i:T &lt;your name&gt; Room}" />

                <TextBlock Text="{i:T WHO CAN JOIN}" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ChoiceButton}" Content="{i:T PUBLIC}" GroupName="Visibility" IsChecked="{Binding IsPublic}" />
                    <RadioButton Style="{StaticResource ChoiceButton}" Content="{i:T PRIVATE}" GroupName="Visibility" IsChecked="{Binding IsPrivate}" />
                </StackPanel>

                <DockPanel Margin="0,18,0,4">
                    <TextBlock Text="{i:T CREW SIZE}" Style="{StaticResource Label}" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding MaxPlayers}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Orange}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="1" Maximum="{Binding PlayerLimit}" Value="{Binding MaxPlayers}" />
                <DockPanel Margin="0,2,0,0">
                    <TextBlock Text="1" Style="{StaticResource Muted}" FontSize="12.5" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding PlayerLimit}" Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Right" />
                </DockPanel>

                <DockPanel Margin="0,18,0,0">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CrossPlay}" VerticalAlignment="Center" />
                    <TextBlock Text="{i:T CROSSPLAY}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>

                <Button Style="{StaticResource LargeButton}" Content="{i:T HOST LOBBY}" Command="{Binding HostLobbyCommand}" HorizontalAlignment="Stretch" Margin="0,30,0,0" />
                <ContentControl Style="{StaticResource PanelFooter}" />
            </StackPanel>
        </c:ShapeBorder>

        <!-- ============================================================ mods -->
        <HeaderedContentControl Grid.Column="2" Style="{StaticResource Section}" Header="{i:T MODS IN YOUR LOBBY}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="18,0,28,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:T MOD}" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="{i:T WHO NEEDS IT}" Style="{StaticResource Label}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{i:T No mods are on.}" Style="{StaticResource Muted}" Visibility="{Binding Mods.Count, Converter={StaticResource Hide}}" />
                <Grid>
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Row}" Padding="12,8" Margin="0,0,10,6" BorderThickness="6,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#55696A6D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JoinersGetIt}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="290" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Version, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
