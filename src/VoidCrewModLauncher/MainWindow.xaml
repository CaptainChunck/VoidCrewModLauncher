<Window x:Class="VoidCrewModLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VoidCrewModLauncher.Controls"
        xmlns:vm="clr-namespace:VoidCrewModLauncher.ViewModels"
        xmlns:v="clr-namespace:VoidCrewModLauncher.Views"
        Title="Void Crew Mod Launcher"
        Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/launcher.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
            <v:BrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <v:ModsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HostViewModel}">
            <v:HostView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="#33A9B6C2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="12" />
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
            </Grid.RowDefinitions>

            <!-- The menu's dark background with its blue glow and sigil. -->
            <c:Backdrop Grid.RowSpan="6" />

            <!-- Meander bands along the top and bottom edges, as on the settings screen. -->
            <c:MeanderBar Grid.Row="0" Height="12" Stroke="{StaticResource Meander}" />
            <c:MeanderBar Grid.Row="5" Height="12" Stroke="{StaticResource Meander}" />

            <!-- Title -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/launcher.png" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="VOID CREW" FontSize="22" FontWeight="Black" Foreground="{StaticResource Gold}" Effect="{StaticResource LogoGlow}" VerticalAlignment="Center" />
                    <c:SpacedText Value="MOD LAUNCHER" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="14,3,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximise" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Tabs on the menu's rule, and the game -->
            <Grid Grid.Row="2" Margin="18,6,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:TabRule Grid.Row="1" Grid.ColumnSpan="2" Stroke="{StaticResource Line}" Margin="-18,0,-18,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="22,0,0,0">
                    <RadioButton Style="{StaticResource NavTab}" Content="SERVER BROWSER" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="browser"
                                 IsChecked="{Binding CurrentPageName, Mode=TwoWay, Converter={StaticResource Is}, ConverterParameter=browser}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="mods"
                                 IsChecked="{Binding CurrentPageName, Mode=TwoWay, Converter={StaticResource Is}, ConverterParameter=mods}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MOD MANAGER" />
                            <Border Background="{StaticResource Red}" Margin="8,0,0,0" Padding="5,0" VerticalAlignment="Center"
                                    Visibility="{Binding Mods.UpdateCount, Converter={StaticResource Show}}" ToolTip="Updates available">
                                <TextBlock Text="{Binding Mods.UpdateCount}" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" Content="HOST LOBBY" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="host"
                                 IsChecked="{Binding CurrentPageName, Mode=TwoWay, Converter={StaticResource Is}, ConverterParameter=host}" />
                    <RadioButton Style="{StaticResource NavTab}" Content="SETTINGS" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings"
                                 IsChecked="{Binding CurrentPageName, Mode=TwoWay, Converter={StaticResource Is}, ConverterParameter=settings}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding GameStateText}" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Margin="8,1,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource LightGrey}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameState}" Value="Menu">
                                            <Setter Property="Fill" Value="{StaticResource Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="Hub">
                                            <Setter Property="Fill" Value="{StaticResource Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="Mission">
                                            <Setter Property="Fill" Value="{StaticResource Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="Starting">
                                            <Setter Property="Fill" Value="{StaticResource Orange}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="Booting">
                                            <Setter Property="Fill" Value="{StaticResource Orange}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="Loading">
                                            <Setter Property="Fill" Value="{StaticResource Orange}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameState}" Value="RunningOutside">
                                            <Setter Property="Fill" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="PLAY" Command="{Binding PlayCommand}" MinWidth="128" FontSize="15"
                            Visibility="{Binding GameRunning, Converter={StaticResource Hide}}" />
                    <Button Style="{StaticResource HexButton}" Content="SHOW GAME" Command="{Binding FocusGameCommand}" Margin="0,0,6,0"
                            Visibility="{Binding GameRunning, Converter={StaticResource Show}}" />
                    <Button Style="{StaticResource CancelButton}" Content="CLOSE GAME" Command="{Binding CloseGameCommand}"
                            Visibility="{Binding GameRunning, Converter={StaticResource Show}}" />
                </StackPanel>
            </Grid>

            <!-- The page -->
            <ContentControl Grid.Row="3" Content="{Binding CurrentPage}" Margin="30,2,30,12" Focusable="False" />

            <!-- Status bar -->
            <Grid Grid.Row="4" Height="30" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Background="{StaticResource RowLine}" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                <ProgressBar Grid.Column="1" Width="220" Value="{Binding StatusProgress, Mode=OneWay}" Maximum="1" Margin="0,0,16,0" VerticalAlignment="Center"
                             Visibility="{Binding StatusProgressVisible, Converter={StaticResource Show}}" />
                <TextBlock Grid.Column="2" Text="{Binding ThunderstoreText}" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
