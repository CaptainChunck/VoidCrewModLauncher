<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The launcher's helper mod inside Void Crew (a BepInEx 5 plugin). The launcher embeds the built DLL and installs it
    into its own BepInEx folder before every launch; players never install it by hand.

    It builds against reference packages, so no game is needed to build it (GitHub's release build has none):
    VoidCrew.GameLibs (the game's assemblies as references, from the Void Crew modding community), BepInEx 5's base
    library and HarmonyX at the versions BepInExPack 5.4.23 ships. tools\build-and-test.ps1 checks the hooks against
    the installed game when there is one.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VoidCrewModLauncher.Bridge</AssemblyName>
    <RootNamespace>VoidCrewModLauncher.Bridge</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Supplied by the game and BepInEx at runtime: references only, nothing is copied to the output. -->
    <PackageReference Include="VoidCrew.GameLibs" Version="1.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="HarmonyX" Version="2.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
